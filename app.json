{
  "expo": {
    "name": "Won Pet Pro",
    "slug": "wonpet-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "scheme": [
      "wonpetpro",
      "com.nowitservices.wonpetpro"
    ],

    "icon": "./src/assets/icon.png",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nowitservices.wonpetpro",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "WON PET PRO uses your camera so your vet can see you and your pet during video consultations.",
        "NSMicrophoneUsageDescription": "WON PET PRO uses your microphone so you can talk to your vet during video consultations."
      }
    },

    "android": {
      "package": "com.nowitservices.wonpetpro",

      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FEF7ED"
      },

      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },

    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-apple-authentication",

      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "backgroundColor": "#FF6B00",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WON PET PRO uses your location to find vets and set delivery addresses near you."
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "5986ec63-2a6f-400b-9bba-989363e4f918"
      }
    }
  }
}